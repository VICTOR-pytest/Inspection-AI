{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Inspection AI — Dashboard operacional completo (Sprint 9B.4)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📊 Visão Geral",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 0 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "PARADO" }, "1": { "text": "ATIVO" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "VisionWorker",
      "type": "stat",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_vision_worker_running", "legendFormat": "Worker Status" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "fps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 3 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "FPS Atual",
      "type": "stat",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_inspection_fps", "legendFormat": "FPS" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 10 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Clientes WebSocket",
      "type": "stat",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_websocket_connections_active", "legendFormat": "Conexões" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.15 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Taxa de Rejeição",
      "type": "stat",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_inspection_error_rate", "legendFormat": "Error Rate" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Uso de Disco",
      "type": "stat",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_storage_disk_bytes_used / (inspection_ai_storage_disk_bytes_used + inspection_ai_storage_disk_bytes_free) * 100", "legendFormat": "Disco %" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "🔍 Inspeções",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Inspeções por Minuto",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(inspection_ai_inspections_total[1m]) * 60", "legendFormat": "Total/min" },
        { "datasource": "Prometheus", "expr": "rate(inspection_ai_inspections_valid_total[1m]) * 60", "legendFormat": "Aprovadas/min" },
        { "datasource": "Prometheus", "expr": "rate(inspection_ai_inspections_invalid_total[1m]) * 60", "legendFormat": "Rejeitadas/min" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Decisões Humanas (acumulado)",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_decisions_approved_total", "legendFormat": "Aprovadas" },
        { "datasource": "Prometheus", "expr": "inspection_ai_decisions_rejected_total", "legendFormat": "Rejeitadas" },
        { "datasource": "Prometheus", "expr": "inspection_ai_decisions_pending",        "legendFormat": "Pendentes" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "⚡ Performance",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Latência HTTP (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.50, rate(inspection_ai_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(inspection_ai_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.99, rate(inspection_ai_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 21,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Latência de Inferência YOLO (p50 / p95)",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.50, rate(inspection_ai_vision_inference_seconds_bucket[5m]))", "legendFormat": "p50 inferência" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(inspection_ai_vision_inference_seconds_bucket[5m]))", "legendFormat": "p95 inferência" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "🔧 Infraestrutura",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "id": 30,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "EventBus — Queue Size",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_eventbus_queue_size", "legendFormat": "Fila" },
        { "datasource": "Prometheus", "expr": "rate(inspection_ai_eventbus_dropped_events_total[1m]) * 60", "legendFormat": "Descartados/min" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "id": 31,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Database Pool",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_db_pool_size",         "legendFormat": "Pool Size" },
        { "datasource": "Prometheus", "expr": "inspection_ai_db_pool_checked_out",   "legendFormat": "Em uso" },
        { "datasource": "Prometheus", "expr": "inspection_ai_db_pool_overflow",      "legendFormat": "Overflow" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "mappings": [
            { "options": { "0": { "color": "green", "text": "CLOSED" }, "1": { "color": "red", "text": "OPEN" }, "2": { "color": "yellow", "text": "HALF-OPEN" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "id": 32,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Circuit Breakers",
      "type": "stat",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_circuit_breaker_state{name=\"persistence\"}", "legendFormat": "Persistência" },
        { "datasource": "Prometheus", "expr": "inspection_ai_circuit_breaker_state{name=\"detector\"}",   "legendFormat": "Detector" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 104,
      "title": "💾 Storage",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 32 },
      "id": 40,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Uso de Disco — Storage",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_storage_disk_bytes_used",  "legendFormat": "Usado" },
        { "datasource": "Prometheus", "expr": "inspection_ai_storage_disk_bytes_free",  "legendFormat": "Livre" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 32 },
      "id": 41,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Imagens em Storage",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "inspection_ai_storage_images_total{variant=\"original\"}",  "legendFormat": "Originais" },
        { "datasource": "Prometheus", "expr": "inspection_ai_storage_images_total{variant=\"annotated\"}", "legendFormat": "Anotadas" },
        { "datasource": "Prometheus", "expr": "rate(inspection_ai_storage_cleanup_deleted_total[1h]) * 3600", "legendFormat": "Deletadas/h (cleanup)" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["inspection-ai", "industrial", "production"],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Inspection AI — Operacional",
  "uid":  "inspection-ai-v1",
  "version": 1
}
