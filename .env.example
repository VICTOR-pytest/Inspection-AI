# ============================================================
# Inspection AI — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
#
# Sprint 9B.4: todas as configurações documentadas.
# Variáveis marcadas com ⚠️ DEVEM ser alteradas em produção.
# ============================================================

# ------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------
APP_NAME=Inspection AI
APP_VERSION=0.1.0

# Ambiente de execução: "dev" | "prod"
#   dev  → CORS aberto (["*"]), /docs habilitado, logs verbosos
#   prod → CORS restrito a ALLOWED_ORIGINS, /docs desabilitado
ENVIRONMENT=dev

# Modo debug: true | false
#   NUNCA usar true em produção — expõe stack traces nas respostas HTTP
DEBUG=false

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
BACKEND_PORT=8000

# Origens CORS permitidas em ENVIRONMENT=prod (separadas por vírgula)
# Ignorado em ENVIRONMENT=dev (["*"] é usado automaticamente)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------
# Banco de Dados (PostgreSQL 16)
# ------------------------------------------------------------
POSTGRES_DB=inspection_ai
POSTGRES_USER=inspection_user
POSTGRES_PASSWORD=inspection_password   # ⚠️ ALTERAR EM PRODUÇÃO
POSTGRES_PORT=5432

# DATABASE_URL é construída automaticamente no docker-compose.yml
# Para uso fora do Docker (dev local):
# DATABASE_URL=postgresql://inspection_user:inspection_password@localhost:5432/inspection_ai

# Pool de conexões SQLAlchemy
# pool_size     : conexões permanentes (recomendado: núcleos × 2)
# max_overflow  : extras acima do pool_size
# pool_timeout  : segundos de espera por conexão antes de TimeoutError
# pool_recycle  : recicla conexões após N segundos (evita "connection closed")
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------
# Câmera / Fonte de frames
# ------------------------------------------------------------
# CAMERA_MODE=simulated → frames sintéticos (sem hardware — padrão)
# CAMERA_MODE=webcam    → câmera física via OpenCV
#   Fallback automático para simulated se câmera indisponível
CAMERA_MODE=simulated
CAMERA_INDEX=0
CAMERA_FPS=5.0

# ------------------------------------------------------------
# Storage de imagens
# ------------------------------------------------------------
# Caminho base para armazenamento de imagens de inspeção.
# Em Docker: /app/storage (volume montado pelo docker-compose)
# Em dev local: ./storage (relativo ao CWD)
STORAGE_PATH=/app/storage

# Retenção de imagens (LGPD / compliance)
# IMAGE_RETENTION_DAYS=0 → nunca deletar automaticamente
# IMAGE_CLEANUP_ENABLED=false → desabilitar limpeza (útil em ambientes auditados)
# IMAGE_CLEANUP_HOUR → hora UTC (0–23) de execução do cleanup diário
IMAGE_RETENTION_DAYS=30
IMAGE_CLEANUP_ENABLED=true
IMAGE_CLEANUP_HOUR=2

# ------------------------------------------------------------
# YOLO (Sprint 8A) — inferência real via YOLOv8
# ------------------------------------------------------------
# YOLO_ENABLED=false → sistema usa FallbackDetector (sem ultralytics)
# Para ativar: pip install ultralytics + fornecer modelo treinado
YOLO_ENABLED=false
YOLO_MODEL_PATH=/vision_module/vision/models/yolov8n.pt
YOLO_CONFIDENCE_MIN=0.50

# ------------------------------------------------------------
# Autenticação JWT (Sprint 9B.1)
# ------------------------------------------------------------
# ⚠️ JWT_SECRET_KEY DEVE ser alterada em produção!
# Gerar chave segura: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------
# WebSocket (Sprint 9B.2)
# ------------------------------------------------------------
# WS_HEARTBEAT_INTERVAL → segundos entre pings de status (30s recomendado)
# WS_SEND_TIMEOUT       → timeout por send; detecta conexões TCP mortas
WS_HEARTBEAT_INTERVAL=30
WS_SEND_TIMEOUT=10.0

# ------------------------------------------------------------
# Circuit Breaker (Sprint 9B.3)
# ------------------------------------------------------------
# CB_FAILURE_THRESHOLD → falhas consecutivas antes de abrir o circuito
# CB_RESET_TIMEOUT     → segundos em OPEN antes de tentar HALF_OPEN
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT=30.0

# ------------------------------------------------------------
# Observabilidade (Sprint 9B.4)
# ------------------------------------------------------------
# Health Check
# HEALTH_TIMEOUT_SECONDS → timeout máximo para cada verificação de dependência
HEALTH_TIMEOUT_SECONDS=5.0

# Prometheus
# PROMETHEUS_ENABLED=true → habilita GET /metrics em formato Prometheus
# Em produção: restringir acesso ao scraper Prometheus via firewall
PROMETHEUS_ENABLED=true

# Disco
# DISK_WARNING_PERCENT  → /health retorna "degraded" quando disco > N% cheio
# DISK_CRITICAL_PERCENT → /health retorna "unhealthy" quando disco > N% cheio
DISK_WARNING_PERCENT=80.0
DISK_CRITICAL_PERCENT=95.0
